{
  "name": "summarize-ai",
  "version": "1.2.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "test": "vp test run",
    "clean": "rm -rf dist",
    "build": "run-s build:content build:popup build:webmcp",
    "build:content": "vp build",
    "build:popup": "vp build --config vite.popup.config.ts",
    "build:webmcp": "vp build --config vite.webmcp.config.ts",
    "dev": "run-s clean dev:watch",
    "dev:watch": "DEV_WATCH=1 run-p -l \"build:* -- --watch\"",
    "demo": "vp build && node scripts/demo-server.mjs",
    "demo:serve": "node scripts/demo-server.mjs",
    "typecheck": "tsc --noEmit",
    "test:watch": "vp test",
    "package": "pnpm run typecheck && pnpm test && pnpm run build && web-ext build --source-dir dist --artifacts-dir release --overwrite-dest"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "packageManager": "pnpm@10.16.1",
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/chrome": "^0.2.2",
    "@types/dom-chromium-ai": "^0.0.17",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "jsdom": "^29.1.1",
    "npm-run-all2": "^9.0.3",
    "typescript": "^7.0.2",
    "vite-plus": "^0.2.6",
    "web-ext": "^10.5.0"
  },
  "dependencies": {
    "@mozilla/readability": "^0.6.0",
    "overlayscrollbars": "^2.16.0",
    "overlayscrollbars-react": "^0.5.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "snarkdown": "^2.0.0"
  }
}
