{
  "manifest_version": 3,
  "name": "Summarize AI Buddy",
  "version": "1.1.0",
  "description": "kkday.com 專屬 pixel 小夥伴：用 Chrome 內建 AI 摘要頁面、生成商品重點、潤飾與翻譯評論、分析值不值得買，全程裝置端運算不上傳",
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["*://kkday.com/*", "*://*.kkday.com/*"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "小夥伴設定"
  },
  "web_accessible_resources": [
    {
      "resources": ["assets/sprite.png", "assets/emoji/*.svg", "assets/emoji/*.webp"],
      "matches": ["*://kkday.com/*", "*://*.kkday.com/*"]
    }
  ],
  "icons": {
    "128": "assets/icon128.png"
  }
}
